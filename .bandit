[bandit]
# Bandit security linting configuration for Resume LLM

# Skip the following test IDs
skips =

# Exclude test files and development configurations
exclude_dirs = tests,__pycache__,.git,.tox,dist,build,*.egg

# Test to exclude with explanations
[skips]
# B104 - hardcoded_bind_all_interfaces: Development servers often bind to 0.0.0.0
# This is acceptable for development, but production should use specific IPs
tests = B104
